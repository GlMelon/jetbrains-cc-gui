#!/bin/sh
# pre-commit hook（T2：前端代码风格分阶段接入）。
#
# 对本轮 staged 的 webview 源文件跑 prettier + eslint --fix（增量，自动修复并 re-stage）。
# 详见 docs/comprehensive-optimization-directions.md §T2 与 webview/.lintstagedrc.json。
#
# 启用方式（仓库根无 package.json，故用 core.hooksPath 指向本 tracked 目录）：
#   git config core.hooksPath .githooks
# 并确保已在 webview/ 执行过 `npm install`（提供 lint-staged / prettier / eslint）。
#
# 容错：若 webview 依赖尚未安装（例如只做 Java/Gradle 开发的同学），跳过并提示，
# 不阻塞提交；CI 的 webview-lint job 作为最终兜底。
set -e

LS="webview/node_modules/.bin/lint-staged"
if [ ! -f "$LS" ]; then
  echo "[pre-commit] 跳过 lint-staged：未找到 $LS"
  echo "[pre-commit] （如需前端风格检查，请在 webview/ 执行 npm install）"
  exit 0
fi

# --cwd webview：lint-staged 在 webview 目录运行，staged 文件路径相对 webview，
# 使 prettier/eslint 能正确读取 webview/.prettierrc.json 与 webview/eslint.config.js。
exec "$LS" --cwd webview
