{
  "name": "ai-bridge",
  "version": "1.0.0",
  "description": "Unified bridge for Claude and Codex SDKs from Java",
  "type": "module",
  "dependencies": {
    "sql.js": "^1.12.0",
    "@opencode-ai/sdk": "^1.17.0"
  },
  "scripts": {
    "test:claude": "node channel-manager.js claude send",
    "test:codex": "node channel-manager.js codex send",
    "test:sdk-status": "node channel-manager.js system getSdkStatus",
    "typecheck": "tsc --noEmit",
    "test:coverage": "node scripts/run-coverage.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,json}\"",
    "test": "node --import tsx --test \"test/**/*.test.{js,mjs,ts}\""
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "istanbul-lib-coverage": "^3.2.0",
    "typescript": "^5.9.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.65.0"
  }
}
