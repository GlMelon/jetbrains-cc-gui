{
  "name": "ai-bridge",
  "version": "1.0.0",
  "description": "Unified bridge for Claude and Codex SDKs from Java",
  "type": "module",
  "dependencies": {
    "sql.js": "^1.12.0",
    "@opencode-ai/sdk": "^1.17.0"
  },
  "scripts": {
    "test:claude": "node channel-manager.js claude send",
    "test:codex": "node channel-manager.js codex send",
    "test:sdk-status": "node channel-manager.js system getSdkStatus",
    "typecheck": "tsc --noEmit",
    "test:coverage": "node scripts/run-coverage.mjs",
    "check:coverage": "node scripts/check-coverage.mjs"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "istanbul-lib-coverage": "^3.2.0",
    "typescript": "^5.9.0"
  }
}
